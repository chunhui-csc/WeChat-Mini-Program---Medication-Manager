/* pages/member-detail/member-detail.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.header {
  width: 90%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
}

.member-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background-color: #4a90e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  margin-right: 20rpx;
  overflow: hidden;
}

.name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.add-btn {
  background-color: #4a90e2;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
}

.bottles-list {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 20rpx;
  align-items: center;
}

.bottle-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 85%;
}

.main-info {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.medicine-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.dosage {
  font-size: 24rpx;
  color: #666;
}

.sub-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.expires.expired {
  color: #d0021b; /* 红色 */
}

.expires.expiring-soon {
  color: #f5a623; /* 橙色 */
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.btn-edit,
.btn-delete {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.btn-edit {
  background-color: #f5f5f5;
  color: #4a90e2;
}

.btn-delete {
  background-color: #f5f5f5;
  color: #d0021b;
}

.member-delete {
  margin-top: 100rpx;
}

.btn-member-delete {
  background-color: red;
}

.text-delete {
  color: #eee;
}

.scroll-view{
  height: 1000rpx;
}