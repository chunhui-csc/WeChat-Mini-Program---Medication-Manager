/**index.wxss**/
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
}

.action-btn {
  width: 45%;
  height: 180rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.action-btn .icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.action-btn .label {
  font-size: 28rpx;
  color: #666;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin: 30rpx 0 20rpx 0;
}

.members-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
}

.member-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 10rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background-color: #4a90e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.info {
  flex: 1;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.detail {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}
