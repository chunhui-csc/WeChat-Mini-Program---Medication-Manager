/* pages/reminders/reminders.wxss */
.container {
  background-color: #f5f5f5;
}

.tab-header {
  display: flex;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #999;
}

.tab.active {
  color: #4a90e2;
  font-weight: 500;
  border-bottom: 4rpx solid #4a90e2;
}

.content {
  height: calc(100vh - 100rpx); /* 减去tab的高度 */
  padding: 20rpx;
}

.reminder-card,
.warning-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reminder-card.confirm{
  background-color: rgb(180, 180, 180);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reminder-card.state-b {
  background: linear-gradient(135deg, #e3f2fd, #42a5f5); 
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reminder-card.state-y {
  background: linear-gradient(135deg, #fff9c4, #fdd835);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reminder-card.state-r {
  background: linear-gradient(135deg, #ffcdd2, #ef5350);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reminder-icon,
.warning-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.reminder-info,
.warning-info {
  flex: 1;
}

.medicine-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.time,
.expires-in {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin: 8rpx 0;
}

.member {
  font-size: 22rpx;
  color: #aaa;
}

.btn-confirm {
  background-color: #7ed321;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}

.btn-confirm-reset {
  background-color: #ead133;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: white;
}

.status-badge.expiring-soon {
  background-color: #f5a623;
}

.status-badge.expired {
  background-color: #d0021b;
}

.warning-card.expiring-card .medicine-name,
.warning-card.expiring-card .expires-in {
  color: #f5a623;
}

.warning-card.expired-card .medicine-name,
.warning-card.expired-card .expires-in {
  color: #d0021b;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;

}